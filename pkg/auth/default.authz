# The built-in policy, used when no policy file is configured. It declares the
# four roles and grants nothing: groups are mapped to roles by configuration,
# and a person in no mapped group holds no role.
#
# A test in policy_test.go holds these roles to the permissions they had
# before the policy language, so changing this file changes who may do what.

# Reads everything in the tenant and changes nothing.
role viewer { allow read on * }

# Runs agents, manages schedules, acknowledges alerts and sets their rules,
# runs evals, deletes published files, and makes and changes projects:
# anyone who can start a run can make a project.
role operator extends viewer {
  allow write on runs, schedules, alerts, evals, artifacts, projects
}

# Everything an operator does, and also defines and revises agents (their
# call policies among them) and what they are grounded in. The natural
# approver of calls between agents.
role manager extends operator {
  allow write on agents, knowledge
}

# Also defines and revises agents, decides what they are grounded in, sets
# limits, manages the workspace's clients, and governs the project tree
# (projects:govern): the workspace itself and company projects.
role admin { allow * on * }
