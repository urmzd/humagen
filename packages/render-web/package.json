{
  "name": "@humagen/render-web",
  "version": "0.27.3",
  "private": true,
  "type": "module",
  "description": "DOM implementations of the humagen primitives, plus theme tokens.",
  "exports": {
    ".": "./src/index.tsx",
    "./theme.css": "./src/theme.css",
    "./ui/*": "./src/ui/*.tsx",
    "./lib/utils": "./src/lib/utils.ts",
    "./fonts.css": "./src/fonts.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@humagen/core": "workspace:*",
    "@humagen/primitives": "workspace:*",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.4.0",
    "radix-ui": "^1.4.3",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  }
