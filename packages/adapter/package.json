{
  "name": "@humagen/adapter",
  "version": "0.33.0",
  "private": true,
  "type": "module",
  "description": "The one adapter between humagen's API and the humagen UI model, shared by the console and the Slack app.",
  "exports": {
    ".": "./src/index.ts",
    "./run": "./src/run.ts",
    "./mail": "./src/mail.ts",
    "./fold": "./src/fold.ts",
    "./home": "./src/home.ts",
    "./question": "./src/question.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/*.test.ts"
  },
  "dependencies": {
    "@humagen/client": "workspace:*",
    "@humagen/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.0"
  }
}
