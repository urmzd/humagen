exports[`an approval as a card > has a one-line title, the whole call and what it does as its body, then Approve, Ask and Decline 1`] = `
[
  {
    "actions": [
      {
        "accessibility_label": "Roll Back: Roll back payments-api in production to deploy #4811?",
        "action_id": "aui.approve#0",
        "confirm": {
          "confirm": {
            "text": "Yes, Continue",
            "type": "plain_text",
          },
          "deny": {
            "text": "Go Back",
            "type": "plain_text",
          },
          "style": "danger",
          "text": {
            "text": "This can't be undone.",
            "type": "plain_text",
          },
          "title": {
            "text": "Are you sure?",
            "type": "plain_text",
          },
        },
        "style": "danger",
        "text": {
          "emoji": true,
          "text": "Roll Back",
          "type": "plain_text",
        },
        "type": "button",
        "value": "{"turnId":"run-1","target":"a1"}",
      },
      {
        "accessibility_label": "Ask a Question: Roll back payments-api in production to deploy #4811?",
        "action_id": "aui.ask#1",
        "text": {
          "emoji": true,
          "text": "Ask",
          "type": "plain_text",
        },
        "type": "button",
        "value": "{"turnId":"run-1","target":"a1"}",
      },
      {
        "accessibility_label": "Decline: Roll back payments-api in production to deploy #4811?",
        "action_id": "aui.deny#2",
        "text": {
          "emoji": true,
          "text": "Decline",
          "type": "plain_text",
        },
        "type": "button",
        "value": "{"turnId":"run-1","target":"a1"}",
      },
    ],
    "block_id": "approval:a1:r1",
