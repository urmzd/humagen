---
import Code from "../components/Code.astro";
import {
  alternatives,
  architecture,
  contact,
  deployIntro,
  limits,
  pages,
  policySnippet,
  prerequisites,
  sizing,
  steps,
} from "../content/site";
import Base from "../layouts/Base.astro";
import { inline } from "../lib/inline";

const toc = [
  { id: "prerequisites", label: "Prerequisites" },
  { id: "architecture", label: "Architecture" },
  ...steps.map((s, i) => ({ id: s.id, label: `${i + 1}. ${s.title}` })),
  { id: "alternatives", label: alternatives.heading },
  { id: "limits", label: limits.heading },
];
---
<Base page={pages.deploy}>
  <div class="wrap guide">
    <header class="guide-head">
      <h1>Deploy your own Humagen</h1>
      <div class="prose lede">
        {deployIntro.map((p) => <p>{p}</p>)}
      </div>
    </header>

    <nav class="toc" aria-labelledby="toc-title">
      <h2 id="toc-title">On this page</h2>
      <ol>
        {toc.map((t) => <li><a href={`#${t.id}`}>{t.label}</a></li>)}
      </ol>
    </nav>

    <div class="guide-body">
      <section id="prerequisites" aria-labelledby="prerequisites-title">
        <h2 id="prerequisites-title">Prerequisites</h2>
        <ul class="prose list">
          {prerequisites.map((p) => <li set:html={inline(p)} />)}
        </ul>
        <p class="prose note" set:html={inline(sizing)} />
      </section>

      <section id="architecture" aria-labelledby="architecture-title">
        <h2 id="architecture-title">Architecture</h2>
        <figure class="arch">
          <div class="arch-grid">
            {
              architecture.zones.map((z, i) => (
                <section class={`zone zone-${i + 1}`} aria-label={z.name}>
                  <h3>{z.name}</h3>
                  <ul>
                    {z.items.map((item) => (
                      <li set:html={inline(item)} />
                    ))}
                  </ul>
                </section>
              ))
            }
          </div>
          <figcaption>{architecture.caption}</figcaption>
        </figure>
      </section>

      <ol class="steps">
        {
          steps.map((s, i) => (
            <li id={s.id}>
              <section aria-labelledby={`${s.id}-title`}>
                <h2 id={`${s.id}-title`}>
                  <span class="step-n" aria-hidden="true">
                    {i + 1}
                  </span>
                  {s.title}
                </h2>
                <div class="prose">
                  {s.body.map((p) => (
                    <p set:html={inline(p)} />
                  ))}
                </div>
                {s.code && <Code label={s.code.label} text={s.code.text} />}
                {s.after && (
                  <div class="prose after">
                    {s.after.map((p) => (
                      <p set:html={inline(p)} />
                    ))}
                  </div>
                )}
                {s.id === "sign-in" && <Code label={policySnippet.label} text={policySnippet.text} />}
              </section>
            </li>
          ))
        }
      </ol>

      <section id="alternatives" aria-labelledby="alternatives-title">
        <h2 id="alternatives-title">{alternatives.heading}</h2>
        <p class="prose">{alternatives.intro}</p>
        <div class="table-scroll" role="region" aria-labelledby="alternatives-title" tabindex="0">
          <table>
            <thead>
              <tr>
                <th scope="col">Setup</th>
                <th scope="col">When</th>
                <th scope="col">What you get</th>
              </tr>
            </thead>
            <tbody>
              {
                alternatives.rows.map((r) => (
                  <tr>
                    <th scope="row" set:html={inline(r.name)} />
                    <td>{r.when}</td>
                    <td>
                      <span set:html={inline(r.what)} /> <a href={r.link.href}>{r.link.label}</a>
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </section>

      <section id="limits" aria-labelledby="limits-title">
        <h2 id="limits-title">{limits.heading}</h2>
        <p class="prose">{limits.intro}</p>
        <ul class="prose list limits">
          {limits.items.map((item) => <li set:html={inline(item)} />)}
        </ul>
        <p class="prose"><a href={limits.link.href}>{limits.link.label}</a></p>
        <p class="prose help">
          Stuck, or running it somewhere else? Write to <a href={contact.href}>{contact.email}</a>.
        </p>
      </section>
    </div>
  </div>
</Base>

<style>
  .guide {
    padding-top: var(--space-12);
    display: grid;
    gap: var(--space-8);
  }

  .guide-head h1 {
    font-size: var(--text-2xl);
    letter-spacing: -0.03em;
  }

  @media (min-width: 48rem) {
    .guide-head h1 {
      font-size: var(--text-hero);
      max-width: 14ch;
    }
  }

  .lede {
    margin-top: var(--space-6);
    font-size: var(--text-lg);
  }

  .toc {
    border: 1px solid var(--rule);
    border-radius: var(--radius-md);
    padding: var(--space-4) var(--space-6);
    background: var(--surface);
    font-size: var(--text-sm);
    align-self: start;
  }

  .toc h2 {
    font-size: var(--text-base);
  }

  .toc ol {
    list-style: none;
    padding: 0;
    margin-top: var(--space-2);
    display: grid;
    gap: var(--space-1);
  }

  .toc a {
    display: inline-block;
    padding-block: var(--space-1);
  }

  .guide-body {
    min-width: 0;
    display: grid;
    gap: var(--space-16);
  }

  .guide-body h2 {
    font-size: var(--text-xl);
    margin-bottom: var(--space-4);
  }

  .list {
    padding-left: 1.25rem;
  }

  .list li + li {
    margin-top: var(--space-2);
  }

  .note {
    margin-top: var(--space-4);
    color: var(--ink-muted);
  }

  .after {
    margin-top: var(--space-6);
  }

  .guide-body > *,
  .steps > li,
  .steps section {
    min-width: 0;
  }

  .steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-16);
  }

  .steps h2 {
    display: flex;
    gap: var(--space-3);
    align-items: baseline;
  }

  .step-n {
    flex: none;
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    border: 1.5px solid var(--action);
    color: var(--action);
    font-size: 1rem;
    transform: translateY(-0.15em);
  }

  .arch {
    margin: 0;
  }

  .arch-grid {
    display: grid;
    gap: var(--space-3);
  }

  .zone {
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    background: var(--surface);
  }

  .zone h3 {
    font-size: var(--text-base);
  }

  .zone ul {
    margin-top: var(--space-2);
    padding-left: 1.1rem;
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  .zone li + li {
    margin-top: var(--space-1);
  }

  .zone-2 {
    border: 2px solid var(--action);
  }

  .zone-4 {
    border-style: dashed;
  }

  .arch figcaption {
    margin-top: var(--space-3);
    font-size: 0.875rem;
    color: var(--ink-muted);
    max-width: var(--measure);
  }

  .limits strong {
    font-weight: 700;
  }

  .help {
    margin-top: var(--space-6);
  }

  #alternatives .table-scroll,
  #limits .list {
    margin-top: var(--space-4);
  }

  #limits .prose + .prose {
    margin-top: var(--space-4);
  }

  @media (min-width: 48rem) {
    .arch-grid {
      grid-template-columns: 1fr 1.3fr 1fr;
      grid-template-areas:
        "tailnet vm outbound"
        ". ci .";
    }
    .zone-1 {
      grid-area: tailnet;
    }
    .zone-2 {
      grid-area: vm;
    }
    .zone-3 {
      grid-area: outbound;
    }
    .zone-4 {
      grid-area: ci;
    }
  }

  @media (min-width: 64rem) {
    .guide {
      grid-template-columns: 15rem minmax(0, 1fr);
      column-gap: var(--space-12);
    }
    .guide-head {
      grid-column: 1 / -1;
    }
    .toc {
      position: sticky;
      top: var(--space-6);
    }
  }
</style>
