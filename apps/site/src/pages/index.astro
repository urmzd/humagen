---
import { Image } from "astro:assets";
import agentsShot from "../assets/console/agents.png";
import homeShot from "../assets/console/home.png";
import turnShot from "../assets/console/ui-agent-turn.png";
import { contact, hero, pages, points, screens, selfHost, site, why } from "../content/site";
import Base from "../layouts/Base.astro";
import { inline } from "../lib/inline";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: site.name,
  description: site.summary,
  url: site.url,
  applicationCategory: "DeveloperApplication",
  operatingSystem: "Linux, macOS",
  license: "https://www.apache.org/licenses/LICENSE-2.0",
  sameAs: site.repo,
};
const shotWidths = [640, 960, 1280];
---
<Base page={pages.home} jsonLd={jsonLd}>
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap hero-text">
      <h1 id="hero-title">{hero.title}</h1>
      <p class="lede">{hero.lede}</p>
      <div class="actions">
        <a class="button" href={pages.deploy.path}>Deploy your own</a>
        <a href={site.repo}>Read the source on GitHub</a>
        <a href={contact.href}>{contact.label}</a>
      </div>
      <p class="status">{hero.status}</p>
    </div>
    <figure class="wrap shot shot-hero">
      <Image
        src={homeShot}
        alt={screens.home.alt}
        widths={shotWidths}
        sizes="(min-width: 72rem) 68rem, calc(100vw - 2rem)"
        format="webp"
        loading="eager"
        fetchpriority="high"
      />
      <figcaption>{screens.home.caption}</figcaption>
    </figure>
  </section>

  <section class="section wrap feature" aria-labelledby="together-title">
    <div class="feature-text">
      <h2 id="together-title">{points.together.title}</h2>
      <p set:html={inline(points.together.body)} />
    </div>
    <figure class="shot">
      <Image src={turnShot} alt={screens.turn.alt} widths={shotWidths} sizes="(min-width: 64rem) 40rem, calc(100vw - 2rem)" format="webp" />
      <figcaption>{screens.turn.caption}</figcaption>
    </figure>
  </section>

  <section class="section wrap feature feature-flip" aria-labelledby="operate-title">
    <div class="feature-text">
      <h2 id="operate-title">{points.operate.title}</h2>
      <p set:html={inline(points.operate.body)} />
    </div>
    <figure class="shot">
      <Image src={agentsShot} alt={screens.agents.alt} widths={shotWidths} sizes="(min-width: 64rem) 40rem, calc(100vw - 2rem)" format="webp" />
      <figcaption>{screens.agents.caption}</figcaption>
    </figure>
  </section>

  <section class="section wrap" aria-labelledby="grid-title">
    <h2 id="grid-title" class="grid-title">Everything a team of agents needs</h2>
    <dl class="points">
      {
        points.grid.map((p) => (
          <div>
            <dt>{p.title}</dt>
            <dd set:html={inline(p.body)} />
          </div>
        ))
      }
    </dl>
  </section>

  <section class="section wrap why" aria-labelledby="why-title">
    <div class="why-text">
      <h2 id="why-title">{why.heading}</h2>
      {why.intro.map((p) => <p>{p}</p>)}
    </div>
    <div class="table-scroll" role="region" aria-labelledby="why-title" tabindex="0">
      <table>
        <thead>
          <tr>
            <th scope="col"><span class="sr-only">Aspect</span></th>
            <th scope="col">{why.columns[1]}</th>
            <th scope="col">{why.columns[2]}</th>
          </tr>
        </thead>
        <tbody>
          {
            why.rows.map(([aspect, ours, theirs]) => (
              <tr>
                <th scope="row">{aspect}</th>
                <td>{ours}</td>
                <td>{theirs}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <section id="self-host" class="selfhost" aria-labelledby="selfhost-title">
    <div class="wrap">
      <h2 id="selfhost-title">{selfHost.heading}</h2>
      <p class="selfhost-intro">{selfHost.intro}</p>
      <ul class="selfhost-points">
        {
          selfHost.points.map((p) => (
            <li>
              <h3>{p.title}</h3>
              <p>{p.body}</p>
            </li>
          ))
        }
      </ul>
      <p class="selfhost-link"><a href={pages.deploy.path}>Read the step-by-step deploy guide</a></p>
    </div>
  </section>

  <section class="section wrap closing" aria-labelledby="closing-title">
    <h2 id="closing-title">Questions before you run it?</h2>
    <p>
      Write to the founder at <a href={contact.href}>{contact.email}</a>, or open an issue on{" "}
      <a href={`${site.repo}/issues`}>GitHub</a>.
    </p>
  </section>
</Base>

<style>
  .hero {
    padding-top: var(--space-12);
  }

  .hero h1 {
    font-size: var(--text-hero);
    letter-spacing: -0.04em;
    line-height: 0.98;
    max-width: 13ch;
  }

  .lede {
    margin-top: var(--space-6);
    font-size: var(--text-lg);
    max-width: 44ch;
  }

  .hero .actions {
    margin-top: var(--space-8);
  }

  .status {
    margin-top: var(--space-6);
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }

  .shot {
    margin: 0;
  }

  .shot img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-md);
    background: #fff;
  }

  .shot figcaption {
    margin-top: var(--space-3);
    font-size: 0.875rem;
    color: var(--ink-muted);
  }

  .shot-hero {
    margin-top: var(--space-12);
  }

  .shot-hero img {
    box-shadow: 0 1.5rem 3rem -1.5rem color-mix(in srgb, var(--ink) 35%, transparent);
  }

  .feature {
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }

  .feature-text {
    max-width: 34rem;
  }

  .feature-text p {
    margin-top: var(--space-4);
    color: var(--ink-muted);
  }

  .grid-title {
    max-width: 18ch;
    margin-bottom: var(--space-8);
  }

  .points {
    display: grid;
    margin: 0;
    border-top: 2px solid var(--ink);
  }

  .points > div {
    padding-block: var(--space-4) var(--space-6);
    border-bottom: 1px solid var(--rule);
  }

  .points dt {
    font-weight: 700;
    font-size: var(--text-lg);
    letter-spacing: -0.01em;
  }

  .points dd {
    margin: var(--space-2) 0 0;
    color: var(--ink-muted);
  }

  .why {
    display: grid;
    gap: var(--space-8);
  }

  .why-text {
    max-width: var(--measure);
  }

  .why-text p {
    margin-top: var(--space-4);
  }

  .why tbody td:first-of-type {
    font-weight: 600;
  }

  .selfhost {
    margin-top: var(--space-16);
    padding-block: var(--space-16);
    background: var(--band);
    color: var(--on-band);
  }

  .selfhost h2 {
    max-width: 16ch;
  }

  .selfhost-intro {
    margin-top: var(--space-4);
    max-width: 52ch;
    font-size: var(--text-lg);
  }

  .selfhost-points {
    list-style: none;
    padding: 0;
    margin-top: var(--space-8);
    display: grid;
    gap: var(--space-6);
  }

  .selfhost-points li {
    border-top: 1px solid var(--band-rule);
    padding-top: var(--space-4);
  }

  .selfhost-points p {
    margin-top: var(--space-2);
    color: var(--on-band-muted);
  }

  .selfhost-link {
    margin-top: var(--space-8);
    font-size: var(--text-lg);
    font-weight: 600;
  }

  .selfhost a {
    color: var(--band-link);
  }

  .selfhost :focus-visible {
    outline-color: var(--band-link);
  }

  .closing p {
    margin-top: var(--space-4);
    max-width: var(--measure);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (min-width: 48rem) {
    .points {
      grid-template-columns: 1fr 1fr;
      column-gap: var(--space-8);
    }
    .selfhost-points {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-8);
    }
  }

  @media (min-width: 64rem) {
    .hero {
      padding-top: var(--space-16);
    }
    .feature {
      grid-template-columns: 1fr 1.35fr;
      gap: var(--space-12);
    }
    .feature-flip .feature-text {
      order: 2;
    }
    .points {
      grid-template-columns: repeat(4, 1fr);
    }
    .why {
      grid-template-columns: 1fr 1.3fr;
      align-items: start;
    }
  }
</style>
