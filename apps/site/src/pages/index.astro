---
import agentsDark from "../assets/console/agents-dark.png";
import agentsLight from "../assets/console/agents-light.png";
import answerDark from "../assets/console/answer-dark.png";
import answerLight from "../assets/console/answer-light.png";
import usageDark from "../assets/console/usage-dark.png";
import usageLight from "../assets/console/usage-light.png";
import Agent from "../components/Agent.astro";
import Icon from "../components/Icon.astro";
import Shot from "../components/Shot.astro";
import {
  actions,
  closing,
  docs,
  hero,
  pages,
  points,
  roster,
  screens,
  selfHost,
  site,
  why,
} from "../content/site";
import Base from "../layouts/Base.astro";
import { type IconName, outlineButton, primaryButton } from "../lib/console";
import { inline } from "../lib/inline";
import { ogImage } from "../lib/og";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: site.name,
  description: site.summary,
  url: site.url,
  applicationCategory: "DeveloperApplication",
  operatingSystem: "Linux, macOS",
  license: "https://www.apache.org/licenses/LICENSE-2.0",
  image: (await ogImage("home")).url,
  sameAs: site.repo,
};
const shot = "glass site-shot m-0";
const side = "(min-width: 64rem) 36rem, calc(100vw - 2.5rem)";
const caption = "px-1 pt-3 text-aui-xs text-aui-muted";
const section = "border-t border-aui-border px-5 py-14 md:px-10 md:py-20";
const h2 = "humagen-display text-aui-xl font-semibold text-aui-fg";
const body = "site-text text-aui-base text-aui-muted";
---
<Base page={pages.home} jsonLd={jsonLd}>
  <div class="site-frame">
    <section
      aria-labelledby="hero-title"
      data-reveal-group
      class="flex flex-col items-center gap-5 px-5 pt-16 pb-14 text-center md:px-10 md:pt-24 md:pb-20"
    >
      <h1
        id="hero-title"
        data-reveal
        class="humagen-display max-w-[16ch] text-balance text-[2.25rem] leading-[1.08] font-semibold tracking-[-0.025em] text-aui-fg sm:text-[3rem] lg:text-[4.25rem]"
      >
        {hero.title}
      </h1>
      <p data-reveal class="max-w-[58ch] text-balance text-aui-lg text-aui-muted">{hero.lede}</p>
      <div data-reveal class="flex flex-wrap items-center justify-center gap-x-5 gap-y-3 pt-2">
        <a class={primaryButton} href={pages.deploy.path}>{actions.deploy}</a>
        <a class="site-link inline-flex min-h-9 items-center gap-1.5 text-aui-base text-aui-fg" href={site.repo}>
          {actions.github}
          <Icon name="external" />
        </a>
      </div>
      <p data-reveal class="text-aui-xs text-aui-muted">{hero.status}</p>
      <figure data-reveal class="m-0 w-full pt-8 text-left">
        <div class={`${shot} shadow-aui-md`}>
          {
            (["light", "dark"] as const).map((t) => (
              <video
                class={`theme-${t}`}
                data-demo
                width="1600"
                height="1000"
                muted
                loop
                playsinline
                preload="none"
                poster={`/demo/demo-${t}.jpg`}
                aria-label={screens.demo.label}
              >
                <source src={`/demo/demo-${t}.mp4`} type="video/mp4" />
              </video>
            ))
          }
        </div>
        <figcaption class={caption}>{screens.demo.caption}</figcaption>
      </figure>
    </section>

    <section
      aria-labelledby="together-title"
      data-reveal-group
      class={`${section} grid items-center gap-8 lg:grid-cols-[1fr_1.35fr] lg:gap-12`}
    >
      <div data-reveal class="flex flex-col gap-3">
        <h2 id="together-title" class={h2}>{points.together.title}</h2>
        <p class={body} set:html={inline(points.together.body)} />
        <ul class="glass mt-2 flex flex-col rounded-aui-lg" aria-label={roster.caption}>
          {
            roster.agents.map((a) => (
              <li class="flex items-center gap-3 border-aui-border px-3.5 py-3 not-first:border-t">
                <Agent name={a.name} hue={a.hue} />
                <span class="min-w-0">
                  <span class="block font-[family-name:var(--font-aui-mono)] text-aui-sm text-aui-fg">
                    {a.name}
                  </span>
                  <span class="block text-aui-xs text-aui-muted">{a.model}</span>
                </span>
              </li>
            ))
          }
        </ul>
        <p class="text-aui-xs text-aui-muted">{roster.caption}</p>
      </div>
      <figure data-reveal class="m-0">
        <Shot light={answerLight} dark={answerDark} alt={screens.answer.alt} sizes={side} />
        <figcaption class={caption}>{screens.answer.caption}</figcaption>
      </figure>
    </section>

    <section
      aria-labelledby="operate-title"
      data-reveal-group
      class={`${section} grid items-center gap-8 lg:grid-cols-[1.35fr_1fr] lg:gap-12`}
    >
      <div data-reveal class="flex flex-col gap-3 lg:order-2">
        <h2 id="operate-title" class={h2}>{points.operate.title}</h2>
        <p class={body} set:html={inline(points.operate.body)} />
      </div>
      <figure data-reveal class="m-0">
        <Shot light={agentsLight} dark={agentsDark} alt={screens.agents.alt} sizes={side} />
        <figcaption class={caption}>{screens.agents.caption}</figcaption>
      </figure>
    </section>

    <section
      aria-labelledby="govern-title"
      data-reveal-group
      class={`${section} grid items-center gap-8 lg:grid-cols-[1fr_1.35fr] lg:gap-12`}
    >
      <div data-reveal class="flex flex-col gap-3">
        <h2 id="govern-title" class={h2}>{points.govern.title}</h2>
        <p class={body} set:html={inline(points.govern.body)} />
      </div>
      <figure data-reveal class="m-0">
        <Shot light={usageLight} dark={usageDark} alt={screens.usage.alt} sizes={side} />
        <figcaption class={caption}>{screens.usage.caption}</figcaption>
      </figure>
    </section>

    <section aria-labelledby="grid-title" data-reveal-group class={section}>
      <h2 id="grid-title" data-reveal class={h2}>What it does</h2>
      <ul
        data-reveal
        class="mt-8 grid gap-px overflow-hidden rounded-aui-lg border border-aui-border bg-aui-border sm:grid-cols-2 lg:grid-cols-4"
      >
        {
          points.grid.map((p) => (
            <li class="site-cell flex flex-col gap-1.5 bg-aui-bg p-5">
              <span class="flex items-center gap-2 text-aui-base font-medium text-aui-fg">
                <Icon name={p.icon as IconName} class="text-aui-muted" />
                {p.title}
              </span>
              <span class="site-text text-aui-sm text-aui-muted" set:html={inline(p.body)} />
            </li>
          ))
        }
      </ul>
    </section>

    <section
      aria-labelledby="why-title"
      data-reveal-group
      class={`${section} grid gap-8 lg:grid-cols-[1fr_1.3fr] lg:gap-12`}
    >
      <div data-reveal class="flex flex-col gap-3">
        <h2 id="why-title" class={h2}>{why.heading}</h2>
        {why.intro.map((p) => <p class={body}>{p}</p>)}
      </div>
      <div
        data-reveal
        class="glass overflow-x-auto rounded-aui-lg"
        role="region"
        aria-labelledby="why-table-title"
        tabindex="0"
      >
        <table class="w-full border-collapse text-left text-aui-sm">
          <caption id="why-table-title" class="sr-only">{why.caption}</caption>
          <thead>
            <tr class="border-b border-aui-border text-aui-xs text-aui-muted">
              <th scope="col" class="px-3.5 py-2.5 font-medium"><span class="sr-only">Aspect</span></th>
              <th scope="col" class="px-3.5 py-2.5 font-medium">{why.columns[1]}</th>
              <th scope="col" class="px-3.5 py-2.5 font-medium">{why.columns[2]}</th>
            </tr>
          </thead>
          <tbody>
            {
              why.rows.map(([aspect, ours, theirs]) => (
                <tr class="border-aui-border align-top not-last:border-b">
                  <th scope="row" class="px-3.5 py-3 font-medium text-aui-fg">{aspect}</th>
                  <td class="px-3.5 py-3 text-aui-fg">{ours}</td>
                  <td class="px-3.5 py-3 text-aui-muted">{theirs}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <section id="self-host" aria-labelledby="selfhost-title" data-reveal-group class={section}>
      <div data-reveal class="flex flex-col gap-3">
        <h2 id="selfhost-title" class={h2}>{selfHost.heading}</h2>
        <p class={`${body} max-w-[62ch]`}>{selfHost.intro}</p>
      </div>
      <ul class="mt-8 grid gap-3 md:grid-cols-3">
        {
          selfHost.points.map((p) => (
            <li data-reveal class="glass site-card flex flex-col gap-1.5 rounded-aui-lg p-5">
              <span class="text-aui-base font-medium text-aui-fg">{p.title}</span>
              <span class="text-aui-sm text-aui-muted">{p.body}</span>
            </li>
          ))
        }
      </ul>
      <div data-reveal class="mt-8">
        <a class={outlineButton} href={pages.deploy.path}>
          {actions.guide}
          <Icon name="chevron" />
        </a>
      </div>
    </section>

    <section aria-labelledby="closing-title" data-reveal-group class={`${section} text-center`}>
      <div data-reveal>
        <h2 id="closing-title" class="humagen-display mx-auto max-w-[22ch] text-[1.75rem] leading-[1.15] font-semibold tracking-[-0.02em] text-aui-fg md:text-[2.5rem]">
          {closing.heading}
        </h2>
        <p class={`${body} mx-auto mt-4 max-w-[56ch]`}>{closing.body}</p>
        <div class="mt-7 flex flex-wrap items-center justify-center gap-x-5 gap-y-3">
          <a class={outlineButton} href={site.repo}>
            {actions.github}
            <Icon name="external" />
          </a>
          <a class="site-link inline-flex min-h-9 items-center text-aui-base text-aui-fg" href={docs.href}>Read the docs</a>
        </div>
      </div>
    </section>
  </div>
  <script>
    // The hero recording plays in the reader's theme, and only with motion
    // allowed; otherwise it rests on its last frame with controls to play it.
    const videos = [...document.querySelectorAll<HTMLVideoElement>("video[data-demo]")];
    const still = matchMedia("(prefers-reduced-motion: reduce)");
    const dark = matchMedia("(prefers-color-scheme: dark)");
    const show = () => {
      for (const v of videos) {
        const visible = v.offsetParent !== null;
        if (!visible) {
          v.pause();
          continue;
        }
        v.controls = still.matches;
        if (still.matches) {
          v.pause();
          continue;
        }
        v.preload = "auto";
        v.play().catch(() => {
          v.controls = true;
        });
      }
    };
    show();
    still.addEventListener("change", show);
    dark.addEventListener("change", show);
  </script>
</Base>
