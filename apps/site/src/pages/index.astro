---
import { Image } from "astro:assets";
import agentsShot from "../assets/console/agents.png";
import homeShot from "../assets/console/home.png";
import turnShot from "../assets/console/ui-agent-turn.png";
import Agent from "../components/Agent.astro";
import Icon from "../components/Icon.astro";
import {
  actions,
  contact,
  hero,
  pages,
  points,
  roster,
  screens,
  selfHost,
  site,
  why,
} from "../content/site";
import Base from "../layouts/Base.astro";
import { type IconName, outlineButton, primaryButton } from "../lib/console";
import { inline } from "../lib/inline";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: site.name,
  description: site.summary,
  url: site.url,
  applicationCategory: "DeveloperApplication",
  operatingSystem: "Linux, macOS",
  license: "https://www.apache.org/licenses/LICENSE-2.0",
  sameAs: site.repo,
};
const widths = [640, 960, 1280];
const shot = "glass site-shot m-0";
const caption = "px-1 pt-3 text-aui-xs text-aui-muted";
const section = "border-t border-aui-border px-5 py-14 md:px-10 md:py-20";
const h2 = "humagen-display text-aui-xl font-semibold text-aui-fg";
const body = "site-text text-aui-base text-aui-muted";
---
<Base page={pages.home} jsonLd={jsonLd}>
  <div class="site-frame">
    <section aria-labelledby="hero-title" data-reveal-group class="flex flex-col gap-4 px-5 pt-14 pb-14 md:px-10 md:pt-20 md:pb-20">
      <h1
        id="hero-title"
        data-reveal
        class="humagen-display max-w-[20ch] text-[1.875rem] leading-[1.15] font-semibold text-aui-fg md:text-[2.75rem]"
      >
        {hero.title}
      </h1>
      <p data-reveal class="max-w-[62ch] text-aui-lg text-aui-muted">{hero.lede}</p>
      <div data-reveal class="flex flex-wrap items-center gap-2 pt-2">
        <a class={primaryButton} href={pages.deploy.path}>{actions.deploy}</a>
        <a class={outlineButton} href={site.repo}>
          {actions.github}
          <Icon name="external" />
        </a>
        <a class={outlineButton} href={contact.href}>{contact.label}</a>
      </div>
      <p data-reveal class="text-aui-xs text-aui-muted">{hero.status}</p>
      <figure data-reveal class="m-0 pt-8">
        <div class={`${shot} shadow-aui-md`}>
          <Image
            src={homeShot}
            alt={screens.home.alt}
            widths={widths}
            sizes="(min-width: 68rem) 63rem, calc(100vw - 2.5rem)"
            format="webp"
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <figcaption class={caption}>{screens.home.caption}</figcaption>
      </figure>
    </section>

    <section
      aria-labelledby="together-title"
      data-reveal-group
      class={`${section} grid items-center gap-8 lg:grid-cols-[1fr_1.35fr] lg:gap-12`}
    >
      <div data-reveal class="flex flex-col gap-3">
        <h2 id="together-title" class={h2}>{points.together.title}</h2>
        <p class={body} set:html={inline(points.together.body)} />
        <ul class="glass mt-2 flex flex-col rounded-aui-lg" aria-label={roster.caption}>
          {
            roster.agents.map((a) => (
              <li class="flex items-center gap-3 border-aui-border px-3.5 py-3 not-first:border-t">
                <Agent name={a.name} hue={a.hue} />
                <span class="min-w-0">
                  <span class="block font-[family-name:var(--font-aui-mono)] text-aui-sm text-aui-fg">
                    {a.name}
                  </span>
                  <span class="block text-aui-xs text-aui-muted">{a.model}</span>
                </span>
              </li>
            ))
          }
        </ul>
        <p class="text-aui-xs text-aui-muted">{roster.caption}</p>
      </div>
      <figure data-reveal class="m-0">
        <div class={shot}>
          <Image src={turnShot} alt={screens.turn.alt} widths={widths} sizes="(min-width: 64rem) 36rem, calc(100vw - 2.5rem)" format="webp" />
        </div>
        <figcaption class={caption}>{screens.turn.caption}</figcaption>
      </figure>
    </section>

    <section
      aria-labelledby="operate-title"
      data-reveal-group
      class={`${section} grid items-center gap-8 lg:grid-cols-[1.35fr_1fr] lg:gap-12`}
    >
      <div data-reveal class="flex flex-col gap-3 lg:order-2">
        <h2 id="operate-title" class={h2}>{points.operate.title}</h2>
        <p class={body} set:html={inline(points.operate.body)} />
      </div>
      <figure data-reveal class="m-0">
        <div class={shot}>
          <Image src={agentsShot} alt={screens.agents.alt} widths={widths} sizes="(min-width: 64rem) 36rem, calc(100vw - 2.5rem)" format="webp" />
        </div>
        <figcaption class={caption}>{screens.agents.caption}</figcaption>
      </figure>
    </section>

    <section aria-labelledby="grid-title" data-reveal-group class={section}>
      <h2 id="grid-title" data-reveal class={h2}>What it does</h2>
      <ul
        data-reveal
        class="mt-8 grid gap-px overflow-hidden rounded-aui-lg border border-aui-border bg-aui-border sm:grid-cols-2 lg:grid-cols-4"
      >
        {
          points.grid.map((p) => (
            <li class="site-cell flex flex-col gap-1.5 bg-aui-bg p-5">
              <span class="flex items-center gap-2 text-aui-base font-medium text-aui-fg">
                <Icon name={p.icon as IconName} class="text-aui-muted" />
                {p.title}
              </span>
              <span class="site-text text-aui-sm text-aui-muted" set:html={inline(p.body)} />
            </li>
          ))
        }
      </ul>
    </section>

    <section
      aria-labelledby="why-title"
      data-reveal-group
      class={`${section} grid gap-8 lg:grid-cols-[1fr_1.3fr] lg:gap-12`}
    >
      <div data-reveal class="flex flex-col gap-3">
        <h2 id="why-title" class={h2}>{why.heading}</h2>
        {why.intro.map((p) => <p class={body}>{p}</p>)}
      </div>
      <div
        data-reveal
        class="glass overflow-x-auto rounded-aui-lg"
        role="region"
        aria-labelledby="why-title"
        tabindex="0"
      >
        <table class="w-full border-collapse text-left text-aui-sm">
          <thead>
            <tr class="border-b border-aui-border text-aui-xs text-aui-muted">
              <th scope="col" class="px-3.5 py-2.5 font-medium"><span class="sr-only">Aspect</span></th>
              <th scope="col" class="px-3.5 py-2.5 font-medium">{why.columns[1]}</th>
              <th scope="col" class="px-3.5 py-2.5 font-medium">{why.columns[2]}</th>
            </tr>
          </thead>
          <tbody>
            {
              why.rows.map(([aspect, ours, theirs]) => (
                <tr class="border-aui-border align-top not-last:border-b">
                  <th scope="row" class="px-3.5 py-3 font-medium text-aui-fg">{aspect}</th>
                  <td class="px-3.5 py-3 text-aui-fg">{ours}</td>
                  <td class="px-3.5 py-3 text-aui-muted">{theirs}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <section id="self-host" aria-labelledby="selfhost-title" data-reveal-group class={section}>
      <div data-reveal class="flex flex-col gap-3">
        <h2 id="selfhost-title" class={h2}>{selfHost.heading}</h2>
        <p class={`${body} max-w-[62ch]`}>{selfHost.intro}</p>
      </div>
      <ul class="mt-8 grid gap-3 md:grid-cols-3">
        {
          selfHost.points.map((p) => (
            <li data-reveal class="glass site-card flex flex-col gap-1.5 rounded-aui-lg p-5">
              <span class="text-aui-base font-medium text-aui-fg">{p.title}</span>
              <span class="text-aui-sm text-aui-muted">{p.body}</span>
            </li>
          ))
        }
      </ul>
      <div data-reveal class="mt-8">
        <a class={outlineButton} href={pages.deploy.path}>
          {actions.guide}
          <Icon name="chevron" />
        </a>
      </div>
    </section>

    <section aria-labelledby="closing-title" data-reveal-group class={section}>
      <div data-reveal>
        <h2 id="closing-title" class={h2}>Questions before you run it?</h2>
        <p class={`${body} mt-3`}>
          Write to the founder at <a href={contact.href}>{contact.email}</a>, or open an issue on{" "}
          <a href={`${site.repo}/issues`}>GitHub</a>.
        </p>
      </div>
    </section>
  </div>
</Base>
