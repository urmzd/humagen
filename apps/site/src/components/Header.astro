---
import { contact, pages, site } from "../content/site";
import Logo from "./Logo.astro";

const current = Astro.url.pathname.replace(/\/$/, "") || "/";
---
<header class="site-header">
  <div class="wrap">
    <a class="wordmark" href="/" aria-label="Humagen home">
      <Logo />
      <span>{site.name}</span>
    </a>
    <nav class="site-nav" aria-label="Main">
      <ul>
        <li>
          <a href={pages.deploy.path} aria-current={current === pages.deploy.path ? "page" : undefined}
            >Deploy guide</a
          >
        </li>
        <li><a href={site.repo}>GitHub</a></li>
        <li><a href={contact.href}>Contact</a></li>
      </ul>
    </nav>
  </div>
</header>
