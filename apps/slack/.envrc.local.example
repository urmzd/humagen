# Copy to the repository root as .envrc.local (gitignored), fill it in, then run `direnv allow`.
# Keep secrets in your secret store and reference them, for example with `op read`.

# Slack: the app created from humagen's sandbox manifest (apps/slack-sandbox)
# Bot token from OAuth & Permissions after installing the app
export SLACK_BOT_TOKEN=""
# App-level token with connections:write, for Socket Mode
export SLACK_APP_TOKEN=""
# The one team this instance serves. Events from any other team are ignored.
export SLACK_TEAM_ID=""
# Optional: Slack member ids, comma separated, who may settle any inbox item and see the whole inbox on Home
export SLACK_OPERATORS=""
# Optional: a branding file (see apps/slack/branding.example.json). A bad file stops startup.
export SLACK_BRANDING=""
# Optional: where open streams are recorded so the next start can close them
export SLACK_STREAM_JOURNAL=""
# Optional: replace a Socket Mode connection silent this long (ms), and exit after this many failures in a row
export SLACK_SOCKET_IDLE_MS=""
export SLACK_SOCKET_MAX_ATTEMPTS=""

# Humagen
export HUMAGEN_URL="http://127.0.0.1:8080"
# The workspace the credential below is for. Startup fails if they disagree.
export HUMAGEN_TENANT=""
# Either a token as is (empty for a loopback server in dev auth) ...
export HUMAGEN_TOKEN=""
# ... or a client-credentials grant, which is refreshed as it expires
export HUMAGEN_OIDC_TOKEN_URL=""
export HUMAGEN_OIDC_CLIENT_ID=""
export HUMAGEN_OIDC_CLIENT_SECRET=""
export HUMAGEN_OIDC_SCOPES="humagen:runs:read humagen:runs:write humagen:agents:read"
export HUMAGEN_OIDC_AUDIENCE=""
# Optional: the client record this app is, for its default agent and its allow-list
export HUMAGEN_CLIENT=""
# Optional: the agent that answers when a message names none and there is no client
export HUMAGEN_DEFAULT_AGENT=""
# Optional: where people reach the console, for links to published files
export HUMAGEN_PUBLIC_URL=""
