{
  "_metadata": { "major_version": 2, "minor_version": 1 },
  "display_information": {
    "name": "Warp",
    "description": "Your workspace's agents in Slack. Ask a question, or review what one is waiting on.",
    "background_color": "#2b50c8"
  },
  "features": {
    "app_home": {
      "home_tab_enabled": true,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": false
    },
    "bot_user": { "display_name": "warp", "always_online": true },
    "shortcuts": [
      {
        "name": "Ask Warp",
        "type": "global",
        "callback_id": "aui_ask",
        "description": "Ask from anywhere. The answer arrives in the app's messages."
      },
      {
        "name": "Ask Warp about this",
        "type": "message",
        "callback_id": "aui_ask_about",
        "description": "Answer in this message's thread, using the message as the question."
      }
    ],
    "slash_commands": [
      {
        "command": "/agent",
        "description": "Ask Warp in this channel",
        "usage_hint": "[question] or help",
        "should_escape": false
      }
    ],
    "agent_view": {
      "agent_description": "Your workspace's agents in Slack. Mention @Warp and the agent you want, such as @Warp @analyst, or message it."
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "assistant:write",
        "channels:history",
        "chat:write",
        "commands",
        "groups:history",
        "im:history",
        "mpim:history",
        "reactions:write",
        "users:read"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "agent_session_stopped",
        "app_home_opened",
        "app_mention",
        "assistant_thread_started",
        "message.im"
      ]
    },
    "interactivity": { "is_enabled": true },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
