{
  "display_information": {
    "name": "Humagen",
    "description": "Mention @Humagen in any channel, thread or DM. It brings in the right agents and answers where you asked.",
    "background_color": "#2b50c8"
  },
  "features": {
    "app_home": {
      "home_tab_enabled": true,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": false,
      "agent_tasks_enabled": true
    },
    "bot_user": {
      "display_name": "Humagen",
      "always_online": true
    },
    "shortcuts": [
      {
        "name": "Ask about this",
        "type": "message",
        "callback_id": "aui_ask_about",
        "description": "Answers in this message's thread, with the message as the question."
      }
    ],
    "agent_view": {
      "agent_description": "Ask anything. Humagen brings in the right agents and answers here.",
      "suggested_prompts": []
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "assistant:write",
        "channels:history",
        "chat:write",
        "commands",
        "groups:history",
        "im:history",
        "mpim:history",
        "reactions:write",
        "users:read",
        "files:read",
        "files:write",
        "canvases:write"
      ]
    },
    "pkce_enabled": false
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "agent_session_stopped",
        "app_home_opened",
        "app_mention",
        "assistant_thread_started",
        "message.im"
      ]
    },
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "is_mcp_enabled": false,
    "token_rotation_enabled": false,
    "app_level_token_rotation_enabled": false
  }
}
