{
  "_metadata": {
    "major_version": 2,
    "minor_version": 1
  },
  "display_information": {
    "name": "agent-ui sandbox",
    "description": "Renders agent-ui fixtures in real Slack: streaming, approvals, failures.",
    "background_color": "#111111"
  },
  "features": {
    "app_home": {
      "home_tab_enabled": true,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": false
    },
    "bot_user": {
      "display_name": "agent-ui-sandbox",
      "always_online": true
    },
    "shortcuts": [
      {
        "name": "Ask the agent",
        "type": "global",
        "callback_id": "aui_ask",
        "description": "Ask from anywhere. The answer arrives in the app's messages."
      },
      {
        "name": "Ask agent about this",
        "type": "message",
        "callback_id": "aui_ask_about",
        "description": "Answer in this message's thread, using the message as the question."
      }
    ],
    "slash_commands": [
      {
        "command": "/agent",
        "description": "Ask the agent in this channel",
        "usage_hint": "[question] or help",
        "should_escape": false
      }
    ],
    "agent_view": {
      "agent_description": "Test bench for agent-ui. Ask anything to see streaming, plans, approvals, and failures rendered by the real Slack client."
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "assistant:write",
        "channels:history",
        "chat:write",
        "commands",
        "files:write",
        "groups:history",
        "im:history",
        "reactions:write"
      ]
    }
  },
  "functions": {
    "aui_ask_step": {
      "title": "Ask the agent",
      "description": "Run one agent turn in a channel and continue when it ends.",
      "input_parameters": {
        "properties": {
          "prompt": {
            "type": "string",
            "title": "Prompt",
            "description": "What to ask"
          },
          "channel_id": {
            "type": "slack#/types/channel_id",
            "title": "Channel",
            "description": "Where the turn runs. The app must be a member."
          },
          "user_id": {
            "type": "slack#/types/user_id",
            "title": "On behalf of",
            "description": "Who the answer is for, and who may approve."
          }
        },
        "required": [
          "prompt",
          "channel_id",
          "user_id"
        ]
      },
      "output_parameters": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "description": "done, denied or stopped"
          },
          "answer": {
            "type": "string",
            "title": "Answer",
            "description": "The agent's reply"
          }
        },
        "required": [
          "status",
          "answer"
        ]
      }
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "agent_session_stopped",
        "app_home_opened",
        "app_mention",
        "function_executed",
        "message.im"
      ]
    },
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": true,
    "function_runtime": "remote",
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
