# Copy to the repo root as .envrc.local (gitignored), then `direnv allow`.
# Prefer 1Password references over pasting tokens: op read resolves them at load time.

# Bot token from OAuth & Permissions after installing the app (xoxb-…)
export SLACK_BOT_TOKEN="$(op read 'op://Private/agent-ui sandbox/bot token')"
# App-level token with connections:write, for Socket Mode (xapp-…)
export SLACK_APP_TOKEN="$(op read 'op://Private/agent-ui sandbox/app token')"
# Sandbox channel the bot is invited to
export SLACK_CHANNEL="C…"
# Your member id (profile → ⋯ → Copy member ID). Streams in channels need a recipient.
export SLACK_TEST_USER="U…"
