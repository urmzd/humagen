# Keep the build context to what the image is built from.
.git
.github
.claude
.worktrees
**/node_modules
**/dist
**/.turbo
bin
build
showcase
# deploy/ holds only the chart the binary embeds (deploy/chart.go and
# deploy/helm/humagen); the rest is not part of the image.
deploy/compose
deploy/flux
deploy/helm/check.sh
# Projects `humagen deploy` writes beside a spec, and wrote before the rename.
**/.humagen
**/.warp
*.log
.env
**/.env
# The Tilt image is built from its own context (.tilt/image).
deploy/tilt
.tilt
Tiltfile
dev.Tiltfile
.humagen-dev
.env.dev
