{
  "name": "humagen",
  "private": true,
  "type": "module",
  "version": "0.46.1",
  "packageManager": "pnpm@11.6.0",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "biome check",
    "fmt": "biome check --write",
    "typecheck": "turbo run typecheck",
    "check": "pnpm run fmt && pnpm run lint && pnpm run typecheck && pnpm test",
    "storybook": "pnpm --filter @humagen/storybook dev",
    "storybook:check": "pnpm --filter @humagen/screens storybook",
    "storybook:capture": "teasr run -c teasr.storybook.toml",
    "sandbox": "pnpm --silent --filter @humagen/slack-sandbox cli",
    "dev": "pnpm --filter @humagen/console dev",
    "test:server": "pnpm --filter @humagen/slack test:server",
    "validate:slack": "pnpm sandbox validate && pnpm --filter @humagen/slack validate",
    "welcome-copy": "node scripts/welcome-copy.mjs",
    "welcome-copy:check": "node scripts/welcome-copy.mjs --check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "turbo": "^2.11.7",
    "typescript": "^6.0.0",
    "vitest": "^5.0.3"
  }
}
