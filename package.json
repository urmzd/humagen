{
  "name": "warp",
  "private": true,
  "type": "module",
  "version": "0.12.1",
  "packageManager": "pnpm@11.6.0",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "biome check",
    "fmt": "biome check --write",
    "typecheck": "turbo run typecheck",
    "check": "pnpm run fmt && pnpm run lint && pnpm run typecheck && pnpm test",
    "storybook": "pnpm --filter @warp/storybook dev",
    "sandbox": "pnpm --silent --filter @warp/slack-sandbox cli",
    "dev": "pnpm --filter @warp/console dev",
    "test:server": "pnpm --filter @warp/slack test:server",
    "validate:slack": "pnpm sandbox validate && pnpm --filter @warp/slack validate"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "turbo": "^2.11.7",
    "typescript": "^6.0.0",
    "vitest": "^5.0.3"
  }
}
