# Copy to .env next to compose.yaml. Every line is optional unless it says
# otherwise; the value shown is the default.

# --- Compose ---------------------------------------------------------------

# Optional services to start: "s3" (MinIO), "redis", or both, comma-separated.
# COMPOSE_PROFILES=s3,redis

# The image to run. `docker compose up --build` builds it from the Dockerfile
# at the repository root and tags it with this name.
# WARP_IMAGE=warp:local

# Where the console and API are published on the host. 127.0.0.1 keeps them
# off the network; set 0.0.0.0 behind a firewall or a reverse proxy.
# WARP_BIND=127.0.0.1
# WARP_PORT=8080

# --- Sign-in ---------------------------------------------------------------

# "oidc" (or "okta") for SSO. "dev", "mock" and "tailscale" trust loopback
# and cannot be reached through a published port: for a preview without an
# identity provider use compose.dev.yaml (see docs/deploy.md).
# WARP_AUTH=oidc

# Where browsers reach warp. The OIDC redirect URI is this plus /auth/callback.
# WARP_PUBLIC_URL=http://localhost:8080

# Required with WARP_AUTH=oidc.
WARP_OIDC_ISSUER=
WARP_OIDC_CLIENT_ID=
WARP_OIDC_CLIENT_SECRET=
WARP_OIDC_AUDIENCE=

# The tenant every caller is confined to.
# WARP_TENANT=default

# An authorization policy file, as warp sees it. Put the file in ./config,
# which is mounted at /etc/warp.
# WARP_AUTHZ_POLICY=/etc/warp/policy.authz

# --- Stores ----------------------------------------------------------------

# Every store. The default is the bundled Postgres; point it at your own
# database to use that instead.
# WARP_POSTGRES_URL=postgres://warp:warp@postgres:5432/warp?sslmode=disable

# The bundled Postgres's password. Change it before the first start: Postgres
# keeps the password it was initialised with.
# POSTGRES_PASSWORD=warp

# The event bus. Empty means in process, which is right for one replica.
# With the redis profile: redis://redis:6379/0 (redis://127.0.0.1:6379/0 with
# compose.dev.yaml).
# WARP_REDIS_URL=

# --- Published files -------------------------------------------------------

# "disk" keeps them in the warp-data volume. "s3" uses the bucket below:
# MinIO with the s3 profile, or any S3-compatible service.
# WARP_STORAGE=disk
# WARP_S3_BUCKET=warp
# WARP_S3_ENDPOINT=http://minio:9000
# WARP_S3_REGION=us-east-1
# WARP_S3_PATH_STYLE=true

# The bucket's credentials. With the s3 profile they are also MinIO's root user
# and password (at least 8 characters). Empty means the AWS default chain.
# WARP_S3_ACCESS_KEY_ID=warp
# WARP_S3_SECRET_ACCESS_KEY=change-me-please

# --- Models and tools ------------------------------------------------------

# A model key, for agents with provider "anthropic".
# ANTHROPIC_API_KEY=

# Anything else for `warp serve`, appended to its flags. Files in ./config are
# at /etc/warp, for example:
# WARP_EXTRA_ARGS=-providers /etc/warp/providers.json -settings /etc/warp/settings.json
