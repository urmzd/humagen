# Copy to .env next to compose.yaml. Every variable here reaches the warp
# container, where the references in config/warp.yaml ({ref: env:NAME}) read
# them. Settings that are not secret (the identity provider, the public URL,
# which store and bucket) are in config/warp.yaml, not here.

# --- Compose ---------------------------------------------------------------

# Optional services to start: "s3" (MinIO), "redis", or both, comma-separated.
# Turn on the matching blobs or bus block in config/warp.yaml too.
# COMPOSE_PROFILES=s3,redis

# The image to run. `docker compose up --build` builds it from the Dockerfile
# at the repository root and tags it with this name.
# WARP_IMAGE=warp:local

# Where the console and API are published on the host. 127.0.0.1 keeps them
# off the network; set 0.0.0.0 behind a firewall or a reverse proxy.
# WARP_BIND=127.0.0.1
# WARP_PORT=8080

# Anything else for `warp serve`, appended to its flags, which win over the
# spec. For example: -webhook-addr 0.0.0.0:8090
# WARP_EXTRA_ARGS=

# --- Secrets the spec names --------------------------------------------------

# auth.oidc.client_secret. Required with the default config/warp.yaml.
WARP_OIDC_CLIENT_SECRET=

# stores.postgres.url. The default is the bundled Postgres; set it to use your
# own database instead.
# WARP_POSTGRES_URL=postgres://warp:warp@postgres:5432/warp?sslmode=disable

# The bundled Postgres's password, also used in the default URL above. Change it
# before the first start: Postgres keeps the password it was initialised with.
# POSTGRES_PASSWORD=warp

# bus.redis.url, with the redis profile and bus.kind=redis.
# WARP_REDIS_URL=redis://redis:6379/0

# blobs.s3.access_key and secret_key, with the s3 profile and blobs.kind=s3.
# They are also MinIO's root user and password (at least 8 characters).
# WARP_S3_ACCESS_KEY_ID=warp
# WARP_S3_SECRET_ACCESS_KEY=change-me-please
# The bucket the s3 profile creates. Match blobs.s3.bucket.
# WARP_S3_BUCKET=warp

# A model key, for a Platform model such as {kind: anthropic, anthropic: {key:
# {ref: env:ANTHROPIC_API_KEY}}}. Any other name a reference uses goes here too,
# such as SLACK_BOT_TOKEN and SLACK_APP_TOKEN.
# ANTHROPIC_API_KEY=
